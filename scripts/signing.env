# Optional code signing. Put your own values in scripts/signing.local.env (ignored by git).
# Without a valid identity the app is ad-hoc signed.
SIGN_IDENTITY="${SIGN_IDENTITY:-}"
SIGN_KEYCHAIN="${SIGN_KEYCHAIN:-}"
SIGN_KEYCHAIN_PASSWORD="${SIGN_KEYCHAIN_PASSWORD:-}"
LOCAL_SIGNING="$(dirname "${BASH_SOURCE[0]}")/signing.local.env"
if [[ -f "$LOCAL_SIGNING" ]]; then source "$LOCAL_SIGNING"; fi
